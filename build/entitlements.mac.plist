<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Electron/V8 need writable+executable memory (JIT). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Voice turns (feat/voice-turns): mic capture for /bridge/voice. Without
	     this key the packaged build gets the mic DENIED silently — dev-mode
	     Electron bypasses the check, which is why the acceptance gate is a
	     PACKAGED-build mic test. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- NOT HERE, deliberately: disable-library-validation and
	     allow-dyld-environment-variables. Together they let
	     DYLD_INSERT_LIBRARIES=<any ad-hoc dylib> run code inside Beacon's main
	     process, its helpers and its renderer, under Beacon's signature and its
	     Keychain and microphone grants (measured on main 9046521's signed build).
	     The native addons (better-sqlite3, node-pty's pty.node and spawn-helper)
	     do not need either key: electron-builder signs them with the app's own
	     Team ID, which is what library validation checks. probe:hardening loads
	     both in a signed build, and shows a foreign-signed addon is refused. -->
</dict>
</plist>
